# Replace YOURUSER with your username before installing.
#
# Only the virtual-AP create/destroy needs privilege, and this grants exactly
# that one command. Because it is NOPASSWD, treat everything the helper will do
# as something any process running as YOURUSER can do without a password — so
# the helper constrains itself:
#
#   * interface names must match ^[a-z][a-z0-9]{0,14}$ (no paths, no shell
#     metacharacters), and every command it runs is an absolute path
#   * `add` requires the base interface to exist, and refuses a target name
#     that already exists as something other than an AP
#   * `del` refuses any interface that is not type AP, so it cannot be aimed at
#     the station interface to drop your uplink
#
# It cannot write files, take arguments that reach a shell, or be turned into a
# general root shell.
YOURUSER ALL=(root) NOPASSWD: /usr/local/bin/phone-share-vif
