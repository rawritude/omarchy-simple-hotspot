#!/usr/bin/env bash
# Minimal privileged helper: create/destroy a virtual AP interface on the WiFi
# radio so a hotspot can run alongside the live uplink.
#
# Invoked only via `pkexec` from hotspot-share, against a polkit action scoped
# `allow_active`. That grant is the reason the validation below is not
# decoration: anything this script will do, a locally logged-in session can do
# without being asked for a password.
#
#   phone-share-vif add <base> [ap]
#   phone-share-vif del [ap]
#
# `del` takes the AP name as its FIRST argument, not its second. It previously
# shared `add`'s "action base ap" shape while the only caller passed
# `del "$AP_IF"` — so the name landed in `base` and the interface actually
# deleted came from `ap`'s default. It worked solely because that default and
# the caller's AP_IF were both "ap0"; changing either would have left the real
# AP interface up, still holding the radio.
set -euo pipefail

IW=/usr/sbin/iw
IP=/usr/bin/ip

# Interfaces this script created, one empty file per name.
#
# Needed because nothing intrinsic separates our AP vif from the station
# interface: both sit on the same phy, and NetworkManager randomises the vif's
# MAC, so neither the phy nor the address identifies it. Type is not enough
# either — NM flips the vif from AP back to `managed` when the hotspot
# connection goes down, so a type-only guard refuses to clean up the very
# interface it created and leaks it until reboot. That was observed, not
# theorised.
#
# /run is root-owned tmpfs cleared at boot, and these vifs do not survive a
# reboot either, so the marker's lifetime matches the interface's exactly.
MARKERS=/run/phone-share-vif

valid_name() { [[ "$1" =~ ^[a-z][a-z0-9]{0,14}$ ]]; }   # 15 chars: IFNAMSIZ - 1

# Empty output means "no such interface", which is an ordinary answer here, not
# a failure: `add` expects the AP not to exist yet and `del` must stay idempotent.
# The trailing `|| true` is load-bearing under `set -eo pipefail` — without it a
# missing interface makes iw fail, pipefail propagates that through awk, and the
# failing command substitution takes the whole script down before either caller
# can react. That aborted teardown with rc=237 and broke start outright.
iface_type() { "$IW" dev "$1" info 2>/dev/null | awk '$1=="type"{print $2}' || true; }

action="${1:-}"

case "$action" in
  add)
    base="${2:-}"; ap="${3:-ap0}"
    valid_name "$ap"   || { echo "bad ap name" >&2; exit 2; }
    valid_name "$base" || { echo "bad base name" >&2; exit 2; }
    [[ -e "/sys/class/net/$base" ]] || { echo "no such base iface" >&2; exit 2; }

    existing="$(iface_type "$ap")"
    if [[ -n "$existing" && "$existing" != "AP" ]]; then
      if [[ -e "$MARKERS/$ap" ]]; then
        # Ours, left behind. NetworkManager flips the vif back to `managed` when
        # the hotspot connection stops, so if a teardown never ran — crash, kill,
        # logout — the interface survives in a state this guard would otherwise
        # refuse for the rest of the boot, with no way out from the widget.
        # The marker proves we created it, so recreating it is safe.
        "$IW" dev "$ap" del 2>/dev/null || true
        existing=""
      else
        # No marker: not ours. The name pattern permits "wlp99s0" just as readily
        # as "ap0", so without this an add could be aimed at the station interface.
        echo "refusing: $ap already exists as type $existing" >&2
        exit 2
      fi
    fi

    if [[ -z "$existing" ]]; then
      "$IW" dev "$base" interface add "$ap" type __ap
      mac="$(cat "/sys/class/net/$base/address")"
      # Locally-administered bit set, rest inherited from the base radio.
      "$IP" link set "$ap" address "02${mac:2}" 2>/dev/null || true
    fi
    mkdir -p "$MARKERS" && : > "$MARKERS/$ap"
    "$IP" link set "$ap" up
    ;;

  del)
    ap="${2:-ap0}"
    valid_name "$ap" || { echo "bad ap name" >&2; exit 2; }

    t="$(iface_type "$ap")"
    # Already gone is success: teardown runs on every stop and on the failure
    # path of start, and must stay idempotent.
    if [[ -z "$t" ]]; then
      rm -f "$MARKERS/$ap"
      exit 0
    fi

    # Delete only what we made. The marker is the primary signal; type==AP is
    # accepted too so a vif created before this marker existed, or by another
    # tool, can still be cleaned up. Either way the station interface — type
    # managed, no marker — is refused, which is the case that matters: under
    # NOPASSWD, dropping the uplink would need no password at all.
    if [[ ! -e "$MARKERS/$ap" && "$t" != "AP" ]]; then
      echo "refusing: $ap is type $t and was not created by this helper" >&2
      exit 2
    fi

    "$IW" dev "$ap" del
    rm -f "$MARKERS/$ap"
    ;;

  *)
    echo "usage: phone-share-vif add <base> [ap] | del [ap]" >&2
    exit 2 ;;
esac
